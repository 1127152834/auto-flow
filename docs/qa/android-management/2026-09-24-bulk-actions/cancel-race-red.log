            cancelled = service.action(batch["id"], "cancelPending", "cancel-original")
            assert cancelled["state"] == "cancelled"
            if probe_result == "cancelled":
                tick.cancel()
                with pytest.raises(asyncio.CancelledError):
                    await tick
            else:
                release.set()
                await tick
            saved = service.get(batch["id"])
