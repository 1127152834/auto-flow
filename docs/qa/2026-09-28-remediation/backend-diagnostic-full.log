                request = next(e["payload"] for e in events if e["kind"] == "interaction")
                await worker.write_lock.acquire()
                reply = asyncio.create_task(manager.send_command(run_id, 1, {
                    "type": "input_prompt_result", "commandId": str(uuid4()),
