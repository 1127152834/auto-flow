{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "electron.vite.config.ts",
    "playwright.ui.config.ts",
    "tests/ui"
  ]
}
